# =========================
# API KEYS / TOKENS
# =========================

# GitHub Personal Access Token
# Obtener en: https://github.com/settings/tokens
# Uso: Crear repositorios, autenticación para push, integración CI/CD
GITHUB_TOKEN=your_github_token_here

# OpenAI API Key
# Obtener en: https://platform.openai.com/api-keys
# Uso: Acceso a modelos GPT, embeddings y otros servicios de OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# =========================
# PLATAFORMA BASE (HU-01)
# =========================

# Backend
APP_NAME=SoftFab Platform
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=softfab
POSTGRES_USER=softfab
POSTGRES_PASSWORD=softfab

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery workers
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_COUNT=3
CELERY_WORKER_POOL=threads

# Workspace efimero por corrida
RUN_WORKSPACE_ROOT=worker_runs

# Upload y persistencia de fuentes
SOURCE_MAX_FILE_BYTES=2000000
SOURCE_MAX_FILES_PER_UPLOAD=300

# Limite de costo por corrida
RUN_MAX_COST_USD=10
