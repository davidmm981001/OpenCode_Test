# =========================
# OPENAI / MODELOS
# =========================
OPENAI_API_KEY=
OPENAI_MODEL_ANALYZER=gpt-5.3-codex
OPENAI_MODEL_STORIES=gpt-5.1-codex
OPENAI_MODEL_CODEGEN=gpt-5.3-codex
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# =========================
# RAG
# =========================
RAG_INDEX_PATH=worker_runs/rag_index
RAG_TOP_K=8
RAG_MIN_SCORE=0.05

# =========================
# GITHUB
# =========================
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_DEFAULT_REPO_PREFIX=modernized
GITHUB_DEFAULT_BASE_BRANCH=main

# =========================
# RAILWAY
# =========================
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=

# =========================
# BASE DATOS / COLAS
# =========================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/modernization
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=2

# =========================
# PREVIEW / COSTOS
# =========================
PREVIEW_IFRAME_ALLOWED_ORIGINS=http://localhost:5173
RUN_COST_LIMIT_USD=20
RUN_STOP_ON_COST_LIMIT=true
# Semantica recomendada:
# PREVIEW_MODE=public -> usa GitHub + Railway
# PREVIEW_MODE=local  -> no publica ni despliega; genera preview local embebible
PREVIEW_MODE=local
# Compatibilidad retroactiva (si PREVIEW_MODE no existe):
# PREVIEW_ENABLED=false fuerza modo local
PREVIEW_ENABLED=true
LOCAL_PREVIEW_BASE_URL=http://127.0.0.1:8000

# =========================
# LIMITES INGESTA
# =========================
MAX_SOURCE_FILE_MB=20
MAX_RUN_FILES=200
