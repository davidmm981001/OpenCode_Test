# The LlamaCloud API key.
# LLAMA_CLOUD_API_KEY=

# The provider for the AI models to use.
MODEL_PROVIDER=openai

# Optional: set this when the app is served from a subpath.
# BASE_URL=

# Optional: set this when the app is served from a subpath.
# BASE_URL=

# Run in dev so the browser frontend can reach the backend.
ENVIRONMENT=dev

# The name of LLM model to use.
MODEL=gpt-5.4

# The context window used when the model metadata does not provide one.
LLM_CONTEXT_WINDOW=1048576

# Name of the embedding model to use.
EMBEDDING_MODEL=text-embedding-3-small

# Dimension of the embedding model to use.
EMBEDDING_DIM=1536

# The OpenAI API key to use.
OPENAI_API_KEY=your_openai_api_key_here

# Optional provider-specific keys.
# OPENAI_API_BASE=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=
# OLLAMA_REQUEST_TIMEOUT=120
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_LLM_DEPLOYMENT=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# T_SYSTEMS_LLMHUB_API_KEY=
# T_SYSTEMS_LLMHUB_BASE_URL=https://llm-server.llmhub.t-systems.net/v2
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# Optional provider-specific keys.
# OPENAI_API_BASE=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=
# OLLAMA_REQUEST_TIMEOUT=120
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_LLM_DEPLOYMENT=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# T_SYSTEMS_LLMHUB_API_KEY=
# T_SYSTEMS_LLMHUB_BASE_URL=https://llm-server.llmhub.t-systems.net/v2
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# The address to start the backend app.
APP_HOST=0.0.0.0

# The port to start the backend app.
APP_PORT=8000

# FILESERVER_URL_PREFIX is the URL prefix of the server storing the images generated by the interpreter.
FILESERVER_URL_PREFIX=/api/files

# Temperature for sampling from the model.
# LLM_TEMPERATURE=

# Maximum number of tokens to generate.
# LLM_MAX_TOKENS=

# The number of similar embeddings to return when retrieving documents.
TOP_K=3

# Optional reranking.
# USE_RERANKER=false
# RERANK_PROVIDER=cohere
# COHERE_API_KEY=

# Optional reranking.
# USE_RERANKER=false
# RERANK_PROVIDER=cohere
# COHERE_API_KEY=

VECTOR_STORE_PROVIDER=chroma

# The directory to store the llamaindex's storage files.
STORAGE_DIR="storage/context"

# The name of the collection in your Chroma database
CHROMA_COLLECTION=default

# The API endpoint for your Chroma database
# CHROMA_HOST=

# The port for your Chroma database
# CHROMA_PORT=

# Optional app behavior.
# USE_LLAMA_CLOUD=false
# LLAMA_CLOUD_INDEX_NAME=
# LLAMA_CLOUD_PROJECT_NAME=
# CONVERSATION_STARTERS=
# CUSTOM_PROMPT=
# SYSTEM_CITATION_PROMPT=
# CHAT_REQUEST_LIMIT_THRESHOLD=0
# E2B_API_KEY=

# Optional app behavior.
# CHUNK_SIZE=1024
# CHUNK_OVERLAP=20
# CHAT_REQUEST_LIMIT_THRESHOLD=0
# USE_LLAMA_CLOUD=false
# LLAMA_CLOUD_INDEX_NAME=
# LLAMA_CLOUD_PROJECT_NAME=
# SYSTEM_CITATION_PROMPT=
# NEXT_QUESTION_PROMPT=


# The local path to the Chroma database.
# Specify this if you are using a local Chroma database.
# Otherwise, use CHROMA_HOST and CHROMA_PORT config above
CHROMA_PATH="storage/chromadb"

# Custom system prompt.
# Example:
# SYSTEM_PROMPT="You are a helpful assistant who helps users with their questions."
# SYSTEM_PROMPT=
