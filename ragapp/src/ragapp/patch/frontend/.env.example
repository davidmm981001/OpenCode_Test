NEXT_PUBLIC_APP_NAME=NexTI RAG Lab
NEXT_PUBLIC_APP_SUBTITLE=Chat, RAG y archivos locales en un solo lugar.
# Wordmark in chat header (NexTI Testing Platform style)
# NEXT_PUBLIC_COMPANY_NAME=NexTI
# NEXT_PUBLIC_COMPANY_LINE=RAG Lab
# Logo in /public — default is nexti-mark.svg; use official PNG/SVG path when available
# NEXT_PUBLIC_LOGO_PATH=/logo-nexti.png
NEXT_PUBLIC_MODEL=gpt-5.4
NEXT_PUBLIC_MODEL_PROVIDER=openai
NEXT_PUBLIC_MODEL_PROVIDER_LABEL=OpenAI
NEXT_PUBLIC_MODEL_CONTEXT_WINDOW=1048576
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_CHAT_API=http://localhost:8000
NEXT_PUBLIC_USE_LLAMACLOUD=false
# Optional: only if admin/chat run on other dev ports (default is same-origin /admin and /)
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3001/admin
# NEXT_PUBLIC_CHAT_URL=http://localhost:3000
