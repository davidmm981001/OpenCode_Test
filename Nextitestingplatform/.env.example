# Optional (CLI only): Postgres connection URI from Dashboard → Database → URI (user postgres).
# Used by: npm run db:storage-policies — do not commit real passwords.
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[project-ref].supabase.co:5432/postgres

# Migrations: link once with `npx supabase link --project-ref <ref>`, then `npm run db:push`

# Jira sync secrets are configured in Supabase Edge Functions, not in frontend env.
# Example:
# npx supabase secrets set JIRA_TOKEN_PROJECT_ALPHA=your-jira-api-token
# UI-managed encrypted credentials require:
# npx supabase secrets set JIRA_CREDENTIALS_MASTER_KEY=<base64-32-byte-key>
