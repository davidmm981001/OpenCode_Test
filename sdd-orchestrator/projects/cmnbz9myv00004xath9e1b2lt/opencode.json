{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4-mini",
  "small_model": "openai/gpt-5.4-mini",
  "default_agent": "build",
  "autoupdate": false,
  "snapshot": true,
  "enabled_providers": [
    "openai"
  ],
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    }
  },
  "instructions": [
    ".openspec/CONTEXT.md"
  ],
  "permission": {
    "bash": "ask",
    "edit": "ask"
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "completed-projects/**"
    ]
  }
}